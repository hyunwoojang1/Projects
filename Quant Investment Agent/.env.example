# ── FRED API (무료 발급: https://fred.stlouisfed.org/docs/api/api_key.html) ──
FRED_API_KEY=your_fred_api_key

# ── WRDS (대학 기관 계정 필요 — 없으면 팩터 피처 스킵됨) ──
WRDS_USERNAME=your_wrds_username
WRDS_PASSWORD=

# ── Instagram Graph API ──
# 발급 방법: Facebook Developer Console → Instagram Graph API 앱 생성
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token
INSTAGRAM_USER_ID=your_instagram_business_account_id

# ── 알림 (Overseer) ──
# 카카오 디벨로퍼스 → 앱 생성 → REST API 키 → /oauth/authorize → 액세스 토큰
KAKAO_REST_API_KEY=your_kakao_rest_api_key
KAKAO_ACCESS_TOKEN=
# 슬랙: api.slack.com/messaging/webhooks → Incoming Webhook URL (없으면 비워도 됨)
SLACK_WEBHOOK_URL=

# ── 캐시 설정 ──
CACHE_DIR=./cache
CACHE_TTL_HOURS_FRED=24
CACHE_TTL_HOURS_WRDS=168
CACHE_TTL_HOURS_MARKET=4

# ── 출력 디렉토리 ──
OUTPUT_DIR=./output

# ── 로그 레벨 (DEBUG / INFO / WARNING / ERROR) ──
LOG_LEVEL=INFO

# ── 이메일 (매일 8시 자동 리포트) ──
# Gmail 앱 비밀번호 발급: Google 계정 → 보안 → 2단계 인증 → 앱 비밀번호
EMAIL_SENDER=your_email@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_RECIPIENT=your_email@gmail.com
